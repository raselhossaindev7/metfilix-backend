PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metflix
JWT_SECRET=metflix_super_secret_change_me
JWT_EXPIRES_IN=7d
# Local dev: exact origins, comma-separated, no trailing slash.
# Production (Render): your frontend origins, e.g. CORS_ORIGIN=https://metfilix.vercel.app
# Mobile apps / curl send no Origin and are always allowed.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Small pool for free-tier Postgres poolers (Render free + Supabase).
PGPOOL_MAX=5
PIXELDRAIN_TEST_VIDEO=https://pixeldrain.dev/api/file/UXZM8kk7
FALLBACK_HLS=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
